{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zemo-spike",
  "version": "0.1.0",
  "identifier": "com.alemhar.zemo.spike",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "control",
        "url": "control.html",
        "title": "Zemo — Phase 0 Share Visibility Spike",
        "width": 520,
        "height": 740,
        "resizable": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true
      },
      {
        "label": "help",
        "url": "help.html",
        "title": "Zemo shortcuts",
        "width": 560,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
